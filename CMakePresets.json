{
    "version": 3,
    "configurePresets": [
        {
            "name": "darwin-debug",
            "displayName": "Darwin Debug",
            "generator": "Ninja",
            "binaryDir": "_build/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "scripts/cmake/toolchain_darwin.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_SUPPRESS_DEVELOPER_WARNINGS": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "1"
            }
        },
        {
            "name": "darwin-relwithdebinfo",
            "displayName": "darwin Release With Debug Info",
            "generator": "Ninja",
            "binaryDir": "_build/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "scripts/cmake/toolchain_darwin.cmake",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_SUPPRESS_DEVELOPER_WARNINGS": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "1"
            }
        },
        {
            "name": "ps3-debug",
            "displayName": "PS3 Debug",
            "generator": "Ninja",
            "binaryDir": "_build/${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "scripts/cmake/toolchain_ps3.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_SUPPRESS_DEVELOPER_WARNINGS": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "1"
            }
        }
    ]
}
